# opic-ign(点火中心 ignition-center) 环境变量（compose/config 覆盖用；生产部署经 /opt/opic-prod/.env 注入）
# ── 数据面（Pigsty：host.docker.internal=宿主网关，HOST_GW_IP 见生产 .env）──
PG_HOST=host.docker.internal
PG_PORT=5433
DB_NAME=opicdb
DB_SCHEMA=ign              # 本中心 schema(OPIC-DB-SCHEMA-01)
# DB_PASSWORD / PG_ADMIN_PASSWORD：口令只在生产 .env，不入库
# ── 中间件（能力中心级隔离，OPIC-TECH-01 v1.1）────────────────────────────────
# CENTER_CODE：中心域码（小写），隔离三件套的根——
#   ① opicdb schema=DB_SCHEMA（opicdb 单实例，每中心一 schema）
#   ② Temporal TaskQueue=WORKFLOW_TASK_QUEUE（留空=center_code）
#   ③ NATS stream=NATS_STREAM（留空=OPIC_<CENTER_CODE>）+ 主题域=opic.<center_code>.>
CENTER_CODE=ign             # 本中心域码(隔离三件套的根)
EVENTBUS_DRIVER=nats        # inproc|nats
EVENTBUS_URL=nats://opic-nats:4222
NATS_STREAM=                # 留空=OPIC_<CENTER_CODE>
NATS_SUBJECT_PREFIX=        # 留空=opic.<CENTER_CODE>
WORKFLOW_DRIVER=temporal    # local|temporal
WORKFLOW_ADDRESS=temporal:7233
WORKFLOW_NAMESPACE=opic
WORKFLOW_TASK_QUEUE=        # 留空=center_code
REDIS_ENABLED=true
REDIS_HOST=opic-redis
# REDIS_PASSWORD / NATS_PASSWORD：见生产 .env
# ── 认证 ──
AUTH_MODE=local            # local|zitadel
ZITADEL_ISSUER=https://auth.opic-ai.ccoe.tech
# JWT_SECRET：见生产 apps/ignition-center/.env
# ── 入口 ──
BASE_DOMAIN=opic-ai.ccoe.tech
TRAEFIK_ENTRYPOINT=websecure
HOST_GW_IP=172.20.0.1
# ── 交付执行位与门面（v1.1；只在部署配置中取值，不进代码常量/字典/界面）──
# 命令面可执行文件与三个目录：本机无挂载 ⇒ 执行位不可用，走 R-15 降级口径（不静默置灰）
IGN_DELIVERY_TOOL_BIN=       # 例 /opt/opic/delivery/bin/ezctl
IGN_DELIVERY_TOOL_ROOT=      # 例 /etc/kubeasz
IGN_DELIVERY_WORK_DIR=       # 留空=取 TOOL_ROOT
IGN_DELIVERY_SSH_DIR=        # 例 /root/.ssh（只透传路径，私钥内容零出口）
# 门面令牌：留空 ⇒ 门面三接口一律 401（关闭态）；真实令牌只在生产 .env，不入库
IGN_DELIVERY_FACADE_TOKEN=
IGN_DELIVERY_FACADE_USER=ignition-agent
